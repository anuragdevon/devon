{display:flex;align-items:center;justify-content:space-between;padding-top:.75rem;border-top:1px solid var(--border-glass);gap:.75rem}.proj-tech{display:flex;align-items:center;flex-wrap:wrap;gap:.25rem}.proj-tech .inline-svg{opacity:.65;transition:opacity .2s ease,transform .2s ease}.proj-tech .inline-svg:hover{opacity:1;transform:translateY(-2px)}.proj-link{font-family:jetbrains mono,monospace;font-size:.78rem;font-weight:500;color:var(--accent);text-decoration:none;white-space:nowrap;letter-spacing:.02em;transition:color .2s ease}.proj-link:hover{color:var(--accent-light)}.open-button{position:fixed;transition:bottom .45s cubic-bezier(.4,0,.2,1),box-shadow .3s ease;bottom:-56px;right:18px;background:linear-gradient(135deg,var(--accent),var(--accent-dark));color:#fff;padding:.8rem 1.2rem;border:none;border-radius:50px;cursor:pointer;z-index:99;box-shadow:0 4px 20px var(--accent-glow)}.open-button:hover{box-shadow:0 6px 28px var(--accent-glow-strong);transform:translateY(-2px)}.open-button .in svg{fill:#fff}.form-popup{display:none;position:fixed;bottom:0;right:18px;z-index:9999;border-radius:var(--radius-card)var(--radius-card)0 0;overflow:hidden}.form-popup.is-open{display:block}.form-container{width:320px;padding:1.4rem;background:var(--form-bg);backdrop-filter:blur(28px)saturate(180%);-webkit-backdrop-filter:blur(28px)saturate(180%);border:1px solid var(--border-glass);border-bottom:none;border-radius:var(--radius-card)var(--radius-card)0 0;box-shadow:0 -8px 40px rgba(0,0,0,.12)}@media(max-width:575.98px){.form-container{width:calc(100vw - 36px)}}.form-container h3{font-size:1rem;font-weight:700;color:var(--text-primary);margin:0;letter-spacing:-.01em}.form-container .text-end{cursor:pointer;color:var(--text-muted-custom);transition:color .2s ease}.form-container .text-end:hover{color:var(--accent)}.form-container .text-end .fa svg{fill:currentColor}.form-container .contact-close{background:0 0;border:0;padding:0;color:inherit;cursor:pointer}.form-container .contact-status{margin:.6rem 0 0;font-size:.8rem;color:var(--text-secondary)}.form-container .contact-status:empty{display:none}.form-container label{font-size:.78rem;font-weight:600;color:var(--text-secondary);letter-spacing:.04em;text-transform:uppercase;margin-bottom:.3rem;display:block}.form-container input[type=text],.form-container input[type=email]{width:100%;padding:.65rem .9rem;margin:0 0 1rem;border:1px solid var(--border-glass);background:var(--bg-secondary);color:var(--text-primary);border-radius:var(--radius-sm);font-size:.9rem;font-family:inherit;transition:border-color .25s ease,box-shadow .25s ease,background .25s ease}.form-container input[type=text]::placeholder,.form-container input[type=email]::placeholder{color:var(--text-muted-custom)}.form-container input[type=text]:focus,.form-container input[type=email]:focus{outline:none;border-color:var(--accent);background:var(--bg-primary);box-shadow:0 0 0 3px var(--accent-glow)}.form-container button[type=submit]{width:100%;margin-top:.25rem;font-size:.82rem;height:2.6rem;min-width:unset}[data-theme=dark] .form-container{box-shadow:0 -8px 40px rgba(0,0,0,.5)}.inline-svg{display:inline-block;vertical-align:middle}.inline-svg svg{width:4em;height:4em;fill:currentColor;display:inline-block;color:var(--text-secondary);transition:color .2s ease}@media(max-width:767.98px){.inline-svg svg{width:3em;height:3em}}.inline-svg svg:hover{color:var(--accent-light)}.fa{display:inline-flex;align-items:center;justify-content:center;vertical-align:middle}.fa svg{width:2em;height:2em;fill:currentColor;display:inline-block;transition:fill .2s ease}.in{display:inline-flex;align-items:center;justify-content:center;vertical-align:middle}.in svg{width:1.2em;height:1.2em;fill:currentColor;display:inline-block;transition:fill .2s ease}@media(max-width:767.98px){.in svg{width:1.1em;height:1.1em}}:root:not([data-theme=light]) .inline-svg--flask svg,:root:not([data-theme=light]) .inline-svg--unreal svg{filter:invert(.85)}footer{background:var(--footer-bg)!important;backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-top:1px solid var(--border-glass)!important;position:absolute;bottom:0;width:100%;font-size:.78rem;font-weight:500;padding-top:1.5rem;padding-bottom:1.5rem;color:var(--text-muted-custom)}footer p{margin:0;letter-spacing:.02em}@media(max-width:767.98px){footer p{text-align:center}}footer .d-inline-flex{gap:.25rem}footer a{color:var(--text-secondary);text-decoration:none;display:inline-flex;align-items:center;justify-content:center;width:2.1rem;height:2.1rem;border-radius:50%;border:1px solid var(--border-glass);background:0 0;transition:var(--transition-base);margin:0 .15rem}footer a:hover{background:var(--accent-glow);border-color:var(--accent);transform:translateY(-2px);box-shadow:0 4px 16px var(--accent-glow)}footer a .fa svg{fill:currentColor}footer a[aria-label=linkedin]:hover{color:#0a66c2;border-color:#0a66c2;box-shadow:0 4px 14px rgba(10,102,194,.25)}footer a[aria-label=twitter]:hover{color:#1d9bf0;border-color:#1d9bf0;box-shadow:0 4px 14px rgba(29,155,240,.25)}footer a[aria-label=youtube]:hover{color:red;border-color:red;box-shadow:0 4px 14px rgba(255,0,0,.18)}