{
  "name": "devon",
  "version": "1.0.0",
  "private": true,
  "description": "Anurag Kar's portfolio (Hugo). npm only supplies Bootstrap's SCSS source.",
  "author": "Anurag Kar",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "hugo server",
    "build": "hugo --gc --minify --panicOnWarning",
    "build:test": "hugo --minify --panicOnWarning -d .build",
    "check": "node tools/check-build.mjs .build",
    "test:browser": "node --test \"tests/browser/*.test.mjs\"",
    "test": "npm run build:test && npm run check && npm run test:browser"
  },
  "dependencies": {
    "bootstrap": "5.0.0-beta3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anuragdevon/devon.git"
  },
  "homepage": "https://anuragkar.netlify.app/"
}
